{
  "name": "agentdoctor",
  "version": "0.1.0",
  "description": "Local-first safety contract tests for tool-using agents",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VikrantSingh01/AgentDr.git"
  },
  "homepage": "https://github.com/VikrantSingh01/AgentDr#readme",
  "bugs": {
    "url": "https://github.com/VikrantSingh01/AgentDr/issues"
  },
  "keywords": [
    "agents",
    "ci",
    "mcp",
    "safety",
    "testing"
  ],
  "type": "module",
  "bin": {
    "agentdoctor": "dist/src/cli.js"
  },
  "files": [
    "dist",
    "schema",
    "examples",
    "docs",
    "scripts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/export-schema.mjs",
    "test": "vitest run",
    "test:e2e": "npm run build && vitest run test/e2e.test.ts",
    "test:mcp": "npm run build && vitest run test/mcp-e2e.test.ts --reporter=verbose",
    "snapshot:mcp": "npm run build && node scripts/update-mcp-snapshot.mjs",
    "record:mcp": "npm run build && node scripts/record-mcp-demo.mjs",
    "demo": "node dist/src/cli.js test examples/agentic-release-contract.yml -- node examples/agentic-release-assistant.mjs",
    "demo:mcp": "node dist/src/cli.js test examples/mcp-release-contract.yml",
    "check": "npm run build && npm test",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0-beta.5",
    "@modelcontextprotocol/server": "2.0.0-beta.5",
    "ajv": "^8.17.1",
    "yaml": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
